{
  "name": "qc-kit",
  "version": "0.1.0",
  "description": "주간 품질검사 집계·감사·회의 문장 작성 에이전트와 스킬, 원본(data/) 수정 차단 훅",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/block-data-edit.js\""
          }
        ]
      }
    ]
  }
}
